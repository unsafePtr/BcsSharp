<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Properties -->
    <PackageId>BcsSharp</PackageId>
    <Version>0.0.1</Version>
    <Authors>Your Name</Authors>
    <Description>Binary Canonical Serialization (BCS) library for .NET with source generator support</Description>
    <PackageTags>bcs;serialization;binary;canonical</PackageTags>
    <RepositoryUrl>https://github.com/yourusername/BcsSharp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nethermind.Numerics.Int256" Version="1.3.6" />
    <PackageReference Include="OneOf" Version="3.0.271" />
  </ItemGroup>


</Project>
